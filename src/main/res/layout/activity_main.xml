<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_surface"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_connected"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/stopSpeakBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/stop_speaking"
            android:textSize="11sp"
            android:textColor="@color/accent_emerald_light"
            android:background="@drawable/stop_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/overlayBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_eye"
            android:background="@drawable/overlay_button_bg"
            android:contentDescription="Toggle floating button"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/rulesBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_rules"
            android:background="@drawable/control_button_bg"
            android:contentDescription="Rules and scheduled tasks"
            android:layout_marginStart="8dp" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/control_button_bg"
            android:contentDescription="Settings"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/interimText" />

    <!-- Interim text (while listening) -->
    <TextView
        android:id="@+id/interimText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/accent_emerald_light"
        android:textStyle="italic"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/footer" />

    <!-- Footer (controls) -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/bg_surface"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/langBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="EN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/control_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/voiceBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/voice_button_bg"
            android:contentDescription="@string/voice_input"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/textInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="@string/hint_speak"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:background="@drawable/input_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/sendBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/send_button_bg"
            android:contentDescription="@string/send"
            android:enabled="false"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
