<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0C">

    <!-- Top bar: back + URL + AI/User toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#18181B"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#27272A"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:text="Loading..."
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ToggleButton
            android:id="@+id/modeToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:textOn="🤖 AI"
            android:textOff="👤 User"
            android:checked="true"
            android:textSize="12sp"
            android:background="#27272A"
            android:textColor="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="4dp"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- AI status bar -->
    <LinearLayout
        android:id="@+id/aiStatusBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:background="#0F1F0F"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 AI is working..."
            android:textColor="#10B981"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnImDone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="I'm done — continue AI"
            android:textSize="11sp"
            android:visibility="gone"
            android:background="#27272A"
            android:textColor="#FFFFFF"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

    <!-- The WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Loading overlay -->
        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#18181B"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnWebBack"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Browser back" />

        <ImageButton
            android:id="@+id/btnWebForward"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_media_next"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Browser forward" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_share"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Share URL" />
    </LinearLayout>

</LinearLayout>
